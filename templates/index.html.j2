<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EV purchase (S6E9) — marimo</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-white p-5">
  <div class="max-w-4xl mx-auto">
    <header class="bg-gray-100 p-6 text-center rounded-lg mb-6">
      <img src="https://raw.githubusercontent.com/marimo-team/marimo/main/docs/_static/marimo-logotype-thick.svg" alt="marimo" class="w-20 h-auto mx-auto mb-3">
      <h1 class="text-2xl font-bold mb-2">Predicting Electric Vehicle Purchases</h1>
      <p class="text-sm">Kaggle playground-series-s6e9 — interactive marimo notebooks on GitHub Pages (WASM)</p>
    </header>

    <main>
      <p class="text-sm text-gray-600 mb-6">
        These notebooks run <strong>in the browser</strong> on a small committed sample.
        They do not download Kaggle data and do not fit LightGBM on ~670k rows.
        Full train / submit: local CLI in the
        <a class="text-blue-600 underline" href="https://github.com/wTaylorBickelmann/ev-purchase-kaggle">repo README</a>.
      </p>

      {% if notebooks %}
      <h2 class="text-xl font-bold text-center my-4">Notebooks</h2>
      <p class="text-center mb-4">Edit mode — you can change cells in the browser</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
        {% for notebook in notebooks %}
        <div class="bg-gray-50 border border-gray-200 rounded-lg overflow-hidden">
          <div class="bg-gray-200 p-3 font-semibold">{{ notebook.display_name }}</div>
          <div class="p-4">
            <a href="{{ notebook.html_path }}" class="inline-block bg-blue-500 hover:bg-blue-600 text-white py-1 px-3 rounded">Open</a>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if apps %}
      <h2 class="text-xl font-bold text-center my-4">Apps</h2>
      <p class="text-center mb-4">Run mode — code hidden</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for app in apps %}
        <div class="bg-gray-50 border border-gray-200 rounded-lg overflow-hidden">
          <div class="bg-gray-100 p-3 font-semibold">{{ app.display_name }}</div>
          <div class="p-4">
            <a href="{{ app.html_path }}" class="inline-block bg-amber-500 hover:bg-amber-600 text-white py-1 px-3 rounded">Open</a>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </main>

    <footer class="mt-10 pt-6 border-t border-gray-200 text-center text-sm text-gray-600">
      <p>Built with <a href="https://marimo.io" class="text-blue-500 hover:underline">marimo</a> html-wasm → GitHub Pages</p>
    </footer>
  </div>
</body>
</html>
